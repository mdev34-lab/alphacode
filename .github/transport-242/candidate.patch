+// Starting must never stop a background service that may own in-flight runs.
+// `activeRuns` is undefined when the probe failed; an unknown count is treated
+// as possibly active so a version-mismatched server is not killed blindly.
+export function decideStart(input: {
+  registered: boolean
+  sameVersion: boolean
+  compiled: boolean
+  factoryDefault: boolean
+  activeRuns: number | undefined
+}): StartDecision {
+  if (!input.registered) return "spawn"
+  if (input.sameVersion && input.compiled && !input.factoryDefault) return "reuse"
+  if (input.activeRuns === undefined || input.activeRuns > 0) return input.sameVersion ? "reuse" : "refuse-active"
+  return "replace"
