+export function decideRestart(input: { registered: boolean; activeRuns: number | undefined }): "proceed" | "refuse-active" {
+  if (!input.registered) return "proceed"
+  if (input.activeRuns === undefined || input.activeRuns > 0) return "refuse-active"
+  return "proceed"
+}
