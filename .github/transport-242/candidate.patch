diff --git a/packages/cli/test/services/daemon.test.ts b/packages/cli/test/services/daemon.test.ts
new file mode 100644
index 0000000..1791a5a
--- /dev/null
+++ b/packages/cli/test/services/daemon.test.ts
@@ -0,0 +1,162 @@
+import { afterAll, beforeAll, describe, expect, test } from "bun:test"
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "fs"
+import { tmpdir } from "os"
+import path from "path"
+import { randomUUID } from "crypto"
+import { Effect, Layer } from "effect"
+import { NodeFileSystem } from "@effect/platform-node"
+
+// The daemon state directory is resolved from XDG_STATE_HOME when the module
+// is first imported, so the isolated directory must be set before the import.
+const stateHome = mkdtempSync(path.join(tmpdir(), "alphacode-daemon-test-"))
+process.env.XDG_STATE_HOME = stateHome
+
+type DaemonModule = typeof import("../../src/services/daemon")
+let mod: DaemonModule
+let installationVersion: string
+
+beforeAll(async () => {
+  mod = await import("../../src/services/daemon")
+  installationVersion = (await import("@opencode-ai/core/installation/version")).InstallationVersion
+})
+
+afterAll(() => {
+  rmSync(stateHome, { recursive: true, force: true })
+})
+
+describe("decideStart", () => {
+  const base = { registered: true, sameVersion: true, compiled: true, factoryDefault: false, activeRuns: 0 }
+
+  test("spawns when nothing is registered", () => {
+    expect(mod.decideStart({ ...base, registered: false })).toBe("spawn")
+    expect(mod.decideStart({ ...base, registered: false, activeRuns: 3 })).toBe("spawn")
+  })
+
+  test("reuses a same-version compiled service even when idle", () => {
+    expect(mod.decideStart(base)).toBe("reuse")
+  })
+
+  test("replaces an idle service that is not reusable", () => {
+    expect(mod.decideStart({ ...base, compiled: false })).toBe("replace")
+    expect(mod.decideStart({ ...base, factoryDefault: true })).toBe("replace")
+    expect(mod.decideStart({ ...base, sameVersion: false })).toBe("replace")
+  })
+
+  test("never stops an active service: same-version reuses instead of replacing", () => {
+    expect(mod.decideStart({ ...base, compiled: false, activeRuns: 1 })).toBe("reuse")
+    expect(mod.decideStart({ ...base, factoryDefault: true, activeRuns: 2 })).toBe("reuse")
+  })
+
+  test("refuses a version-mismatched service with active runs", () => {
+    expect(mod.decideStart({ ...base, sameVersion: false, activeRuns: 1 })).toBe("refuse-active")
+  })
+
+  test("treats an unknown active count as possibly active", () => {
+    expect(mod.decideStart({ ...base, sameVersion: false, activeRuns: undefined })).toBe("refuse-active")
+    expect(mod.decideStart({ ...base, compiled: false, activeRuns: undefined })).toBe("reuse")
+  })
+})
+
+describe("decideRestart", () => {
+  test("proceeds when nothing is registered", () => {
+    expect(mod.decideRestart({ registered: false, activeRuns: undefined })).toBe("proceed")
+  })
+
+  test("proceeds only when the registered service is confirmed idle", () => {
+    expect(mod.decideRestart({ registered: true, activeRuns: 0 })).toBe("proceed")
+    expect(mod.decideRestart({ registered: true, activeRuns: 1 })).toBe("refuse-active")
+    expect(mod.decideRestart({ registered: true, activeRuns: undefined })).toBe("refuse-active")
+  })
+})
+
+function alive(pid: number) {
+  try {
+    process.kill(pid, 0)
+    return true
+  } catch {
+    return false
+  }
+}
+
+async function fakeServer(input: { version: string; activeRuns: number }) {
+  const sessions = Object.fromEntries(
+    Array.from({ length: input.activeRuns }, (_, i) => [`ses_test_${i}`, { type: "running" }]),
+  )
+  const server = Bun.serve({
+    hostname: "127.0.0.1",
+    port: 0,
+    fetch(req) {
+      const url = new URL(req.url)
+      if (url.pathname === "/api/health") return Response.json({ healthy: true })
+      if (url.pathname === "/api/session/active") return Response.json({ data: sessions })
+      return new Response("not found", { status: 404 })
+    },
+  })
+  return server
+}
+
+describe("daemon start/restart with a live active run (integration)", () => {
+  const cases = [
+    { name: "same-version service with an active run is reused, not replaced", version: "", activeRuns: 1 },
+  ] as const
+
+  for (const item of cases) {
+    test(item.name, async () => {
+      const version = item.version || installationVersion
+      const server = await fakeServer({ version, activeRuns: item.activeRuns })
+      // A real process stands in for the registered server so a stop would be observable.
+      const child = Bun.spawn(["sleep", "30"], { stdio: ["ignore", "ignore", "ignore"] })
+      try {
+        const layer = mod.layer.pipe(Layer.provide(NodeFileSystem.layer))
+        const program = Effect.gen(function* () {
+          const daemon = yield* mod.Service
+          yield* daemon.password("test-password")
+          const file = path.join(stateHome, "opencode", "server.json")
+          mkdirSync(path.dirname(file), { recursive: true })
+          writeFileSync(file, JSON.stringify({ id: randomUUID(), version, url: server.url.origin, pid: child.pid }))
+          return yield* Effect.gen(function* () {
+            const started = yield* daemon.start()
+            const restarted = yield* daemon.restart().pipe(Effect.result)
+            return { started, restarted }
+          })
+        })
+        const result = await Effect.runPromise(Effect.provide(program, layer))
+        expect(result.started).toBe(server.url.origin)
+        expect(result.restarted._tag).toBe("Failure")
+        if (result.restarted._tag === "Failure") {
+          expect(String(result.restarted.failure)).toContain("active run(s)")
+        }
+        // The registered process must still be alive: nothing was stopped or respawned.
+        expect(alive(child.pid)).toBe(true)
+      } finally {
+        child.kill()
+        server.stop(true)
+      }
+    })
+  }
+
+  test("version-mismatched service with an active run is refused and left running", async () => {
+    const server = await fakeServer({ version: "0.0.0-mismatch", activeRuns: 1 })
+    const child = Bun.spawn(["sleep", "30"], { stdio: ["ignore", "ignore", "ignore"] })
+    try {
+      const layer = mod.layer.pipe(Layer.provide(NodeFileSystem.layer))
+      const program = Effect.gen(function* () {
+        const daemon = yield* mod.Service
+        yield* daemon.password("test-password")
+        mkdirSync(path.join(stateHome, "opencode"), { recursive: true })
+        writeFileSync(
+          path.join(stateHome, "opencode", "server.json"),
+          JSON.stringify({ id: randomUUID(), version: "0.0.0-mismatch", url: server.url.origin, pid: child.pid }),
+        )
+        return yield* daemon.start().pipe(Effect.result)
+      })
+      const result = await Effect.runPromise(Effect.provide(program, layer))
+      expect(result._tag).toBe("Failure")
+      if (result._tag === "Failure") expect(String(result.failure)).toContain("active run(s)")
+      expect(alive(child.pid)).toBe(true)
+    } finally {
+      child.kill()
+      server.stop(true)
+    }
+  })
+})
