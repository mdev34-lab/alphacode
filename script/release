#!/usr/bin/env bash
# usage: [VERSION=0.2.0] script/release [auto|patch|minor|major] [--dry-run]
set -euo pipefail

BUMP=auto
DRY=false
for a in "$@"; do
  case "$a" in
    --dry-run) DRY=true ;;
    *) BUMP="$a" ;;
  esac
done

args=(gh workflow run publish.yml --ref dev -f "bump=$BUMP" -f "dry_run=$DRY")
if [[ -n "${VERSION:-}" ]]; then
  args+=(-f "version=$VERSION")
fi
"${args[@]}"
