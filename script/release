#!/usr/bin/env bash
# usage: script/release [--dry-run]
#
# Dispatches the publish workflow on dev. The release version is the one already
# committed in package.json; bump it first with ./script/bump.ts.
set -euo pipefail

DRY=false
for a in "$@"; do
  case "$a" in
    --dry-run) DRY=true ;;
    *)
      echo "Unknown release argument '$a'; expected --dry-run." >&2
      exit 2
      ;;
  esac
done

gh workflow run publish.yml --ref dev -f "dry_run=$DRY"
